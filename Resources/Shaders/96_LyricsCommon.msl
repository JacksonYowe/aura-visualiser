// Shared pieces for every lyric style. One instance per word (or per particle when du == 0).

struct LyricInstance {
    float cx, cy, size, alpha;
    float u0, v0, du, dv;
    float textAspect, textScale, seed, pop;
    float progress, rotation, appear, glow;
};

struct LyricOut {
    float4 pos [[position]];
    float2 local;                      // text units: the word's box spans x ∈ ±aspect, y ∈ ±1 (y down)
    float2 screenUV;
    float4 rect [[flat]];
    float size [[flat]];
    float alpha [[flat]];
    float textAspect [[flat]];
    float textScale [[flat]];
    float seed [[flat]];
    float pop [[flat]];
    float progress [[flat]];
    float appear [[flat]];
    float glow [[flat]];
};

vertex LyricOut vLyricText(uint vid [[vertex_id]], uint iid [[instance_id]],
                           constant Uniforms& u [[buffer(0)]],
                           constant LyricInstance* items [[buffer(1)]]) {
    LyricInstance b = items[iid];
    bool particle = b.du <= 0.0;
    float2 corner = float2((vid & 1) ? 1.0 : -1.0, (vid & 2) ? 1.0 : -1.0);
    float A = particle ? 1.0 : b.textAspect;
    float margin = particle ? 1.5 : 1.0;       // room for glows, outlines and shadows
    float2 local = corner * float2(A + margin, 1.0 + margin);

    float c = cos(b.rotation), s = sin(b.rotation);
    float2 q = local * b.size;
    q = float2(c * q.x - s * q.y, s * q.x + c * q.y);
    float aspect = u.resX / u.resY;
    float2 p = float2(b.cx, b.cy) + q;

    LyricOut o;
    o.pos = float4(p.x / (0.5 * aspect), -p.y / 0.5, 0.0, 1.0);
    o.local = local;
    o.screenUV = float2(p.x / aspect + 0.5, p.y + 0.5);
    o.rect = float4(b.u0, b.v0, b.du, b.dv);
    o.size = b.size;
    o.alpha = b.alpha;
    o.textAspect = b.textAspect;
    o.textScale = b.textScale;
    o.seed = b.seed;
    o.pop = b.pop;
    o.progress = b.progress;
    o.appear = b.appear;
    o.glow = b.glow;
    return o;
}

// Glyph coverage at a point of the word box (0 outside the box).
inline float lyricInk(texture2d<float> atlas, float4 rect, float aspect, float2 local, float lod) {
    float2 t = float2(local.x / aspect * 0.5 + 0.5, local.y * 0.5 + 0.5);
    float inside = step(0.0, t.x) * step(t.x, 1.0) * step(0.0, t.y) * step(t.y, 1.0);
    return atlas.sample(sLinear, rect.xy + clamp(t, 0.0, 1.0) * rect.zw, level(lod)).r * inside;
}

// Blurred coverage that fades smoothly past the box edge — for glows and shadows.
inline float lyricHaze(texture2d<float> atlas, float4 rect, float aspect, float2 local, float lod) {
    float2 t = float2(local.x / aspect * 0.5 + 0.5, local.y * 0.5 + 0.5);
    float2 over = max(abs(t - 0.5) - 0.5, 0.0) * float2(aspect * 2.0, 2.0);
    return atlas.sample(sLinear, rect.xy + clamp(t, 0.0, 1.0) * rect.zw, level(lod)).r * exp(-length(over) * 3.0);
}

inline float hash11(float x) { return fract(sin(x * 91.3458) * 47453.5453); }
