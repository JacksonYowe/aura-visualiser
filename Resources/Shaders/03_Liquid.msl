// LIQUID — the cover melts and swirls like oil on water; the louder it gets, the wilder the flow.

fragment float4 fLiquid(MODE_ARGS) {
    float a = aspectOf(u);
    float2 p = centered(in.uv, u);
    float r = length(p);
    float t = u.flow * 0.12;

    // Domain warping (two layers of fractal noise feeding each other).
    const float sc = 1.5;
    float2 q = float2(fbm(p * sc + float2(0.0, t)), fbm(p * sc + float2(5.2, 1.3) - t));
    float2 w = float2(fbm(p * sc + 3.2 * q + float2(1.7, 9.2) + t * 0.8),
                      fbm(p * sc + 3.2 * q + float2(8.3, 2.8) - t * 0.7));

    float amount = 0.10 + 0.26 * u.energy + 0.10 * u.bass;
    float2 warp = (w - 0.5) * amount;
    // Kick ripples radiating from the centre.
    warp += (p / max(r, 1e-4)) * sin(r * 36.0 - u.time * 7.0) * 0.007 * (u.bass + u.beat);

    float2 cp = (p + warp) / max(a, 1.0) * 0.92 + 0.5;
    float2 split = normalize(w - 0.5 + 1e-4) * (0.002 + 0.012 * u.beat);
    float3 c = float3(cover(prevArt, art, sMirror, cp + split, 0.6, u.artMix).r,
                      cover(prevArt, art, sMirror, cp, 0.6, u.artMix).g,
                      cover(prevArt, art, sMirror, cp - split, 0.6, u.artMix).b);

    // Iridescent tint that rides the flow field.
    float3 tint = paletteColor(u, w.x * 1.6 + t * 0.25);
    c = mix(c, c * tint * 1.7, 0.22 + 0.25 * u.mid);

    // Bright ridges where the currents fold over.
    float ridge = pow(1.0 - abs(w.y - 0.5) * 2.0, 14.0);
    c += u.c2.rgb * ridge * (0.10 + 0.35 * u.treble + 0.6 * u.hit);

    c = saturateColor(c, 1.2) * (0.8 + 0.3 * u.energy + 0.2 * u.beat);

    // A little persistence so movement leaves a silky trail.
    float3 prev = feedback.sample(sLinear, (in.uv - 0.5) * 0.996 + 0.5).rgb;
    c = mix(c, prev, 0.3);

    c *= smoothstep(1.1, 0.25, r);
    return float4(c, 1.0);
}
