// SCOPE — the actual sound wave drawn as glowing ribbons in the cover's colours,
// leaving trails that drift outward over a soft-focus cover.

inline float ribbonDistance(texture2d<float> wave, float2 P, float aspect, float amp, float shift, float sign) {
    const float stepX = 1.0 / 512.0;
    float x = P.x / aspect;
    float best = 1e3;
    for (int j = -3; j <= 3; j++) {
        float x0 = x + float(j) * stepX;
        float x1 = x0 + stepX;
        float2 A = float2(x0 * aspect, 0.5 - sign * waveAt(wave, x0 + shift) * amp);
        float2 B = float2(x1 * aspect, 0.5 - sign * waveAt(wave, x1 + shift) * amp);
        best = min(best, sdSegment(P, A, B));
    }
    return best;
}

fragment float4 fScope(MODE_ARGS) {
    float a = aspectOf(u);
    float2 p = centered(in.uv, u);

    float fade = pow(0.87, u.dt * 60.0);
    float2 fuv = (in.uv - 0.5) * (0.986 - 0.02 * u.bass) + 0.5;
    float3 prev = feedback.sample(sLinear, fuv).rgb * fade;

    float3 bg = coverBackdrop(prevArt, art, u, p, 5.0, 1.3, 0.0);
    bg = saturateColor(bg, 1.2) * (0.13 + 0.06 * u.energy) * smoothstep(1.0, 0.1, length(p));

    float2 P = float2(in.uv.x * a, in.uv.y);
    float px = 1.0 / u.resY;
    float amp = 0.12 + 0.16 * u.energy + 0.05 * u.beat;

    float3 lines = float3(0.0);
    float3 colors[3] = { u.c0.rgb, u.c1.rgb, u.c2.rgb };
    float amps[3] = { 1.0, -0.8, 0.55 };
    float shifts[3] = { 0.0, 0.021, 0.047 };
    for (int k = 0; k < 3; k++) {
        float d = ribbonDistance(wave, P, a, amp * abs(amps[k]), shifts[k], sign(amps[k]));
        float core = smoothstep(2.2 * px, 0.4 * px, d);
        float glow = exp(-d / (7.0 * px)) * 0.35 + exp(-d / (40.0 * px)) * 0.12;
        lines += colors[k] * (glow * (0.6 + 0.8 * u.energy + 0.8 * u.hit)) + mix(colors[k], float3(1.0), 0.6) * core;
    }

    float3 col = max(prev, bg + lines);
    return float4(col, 1.0);
}
