// SKYLINE — a mirrored spectrum of bars you see the album cover through,
// standing on a reflective floor. Bass in the middle, treble at the edges.

struct BarSample { float3 color; float mask; float glow; };

inline BarSample skylineBar(float2 uv, constant Uniforms& u, texture2d<float> prevArt, texture2d<float> art,
                            texture2d<float> spectrum, float horizon) {
    const float N = 56.0;
    float a = u.resX / u.resY;
    float xm = abs(uv.x - 0.5) * 2.0;
    float cell = xm * N * 0.5;
    float idx = floor(cell);
    float bx = (idx + 0.5) / (N * 0.5);
    float v = specAt(spectrum, 0.01 + bx * 0.9);
    float pk = peakAt(spectrum, 0.01 + bx * 0.9);

    float cellW = a / N;
    float lx = (fract(cell) - 0.5) * cellW;
    float bw = 0.34 * cellW;
    float height = 0.02 + 0.56 * v;
    float top = horizon - height;
    float d = sdRoundBox(float2(lx, uv.y - (top + horizon) * 0.5), float2(bw, height * 0.5 + bw), bw);
    float px = 1.0 / u.resY;

    float2 p = centered(uv, u);
    float3 fill = cover(prevArt, art, sLinear, p / max(a, 1.0) * 0.95 + float2(0.5, 0.42), 0.4, u.artMix);
    fill = saturateColor(fill, 1.2) * 1.2;
    fill = mix(fill, u.c2.rgb, smoothstep(top + 0.12, top, uv.y) * 0.45);

    BarSample s;
    s.mask = smoothstep(px, -px, d);
    s.glow = exp(-max(d, 0.0) * 70.0) * (0.1 + 0.4 * v);
    s.color = fill * (0.8 + 0.5 * v);

    // Peak-hold cap.
    float capY = horizon - (0.02 + 0.56 * pk) - 0.012;
    float cap = smoothstep(2.0 * px, 0.0, abs(uv.y - capY) - 1.5 * px) * step(abs(lx), bw);
    s.color = mix(s.color, mix(u.c2.rgb, float3(1.0), 0.5), cap * (1.0 - s.mask));
    s.mask = max(s.mask, cap * 0.9);
    return s;
}

fragment float4 fSkyline(MODE_ARGS) {
    float2 uv = in.uv;
    float2 p = centered(uv, u);
    const float horizon = 0.72;

    float3 col = coverBackdrop(prevArt, art, u, p + float2(0.0, 0.08), 6.5, 1.3, 0.0);
    col = saturateColor(col, 1.3) * mix(0.30, 0.06, smoothstep(0.1, 1.0, uv.y));

    if (uv.y <= horizon) {
        BarSample b = skylineBar(uv, u, prevArt, art, spectrum, horizon);
        col += b.color * b.glow;
        col = mix(col, b.color, b.mask);
    } else {
        // Rippled reflection below the horizon.
        float depth = uv.y - horizon;
        float2 ruv = float2(uv.x + sin(uv.y * 55.0 - u.time * 2.2) * 0.0007 * (1.0 + u.bass) * smoothstep(0.0, 0.08, depth),
                            horizon - depth * 1.15);
        BarSample b = skylineBar(ruv, u, prevArt, art, spectrum, horizon);
        float fade = exp(-depth * 9.0) * 0.4;
        col += b.color * (b.mask + b.glow) * fade;
    }

    // Horizon glow.
    col += u.c0.rgb * exp(-abs(uv.y - horizon) * 160.0) * (0.25 + 0.6 * u.bass + 0.9 * u.beat);
    col *= smoothstep(1.2, 0.3, length(p));
    return float4(col, 1.0);
}
